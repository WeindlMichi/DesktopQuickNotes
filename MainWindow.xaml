<Window x:Class="DesktopQuickNotes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Notes"

        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"

        Topmost="True"
        
        ShowInTaskbar="False"
        MouseDown="Window_MouseDown"
        PreviewMouseRightButtonUp="NoteBox_PreviewMouseRightButtonUp">
    
    <Grid>
        <Border
            Background="#80000000"
            CornerRadius="12"
            Padding="10">

            <TextBox
                Name="NotesBox"
                Background="Transparent"
                Foreground="White"
                CaretBrush="White"
                BorderThickness="0"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                FontSize="14"
                MouseDoubleClick="NotesBox_MouseDoubleClick"/>

        </Border>

        <Button
            Click="ButtonClose_Click"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Cursor="Hand"
            Margin="0,-5,0,0"
            Width="25"
            Height="25">

            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#A0FFFFFF"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="FontSize" Value="18"/>

                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>

                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <Popup Name="SettingsPopUp"
               StaysOpen="False"
               Placement="Center"
               PlacementTarget="{Binding ElementName=NotesBox}"
               AllowsTransparency="True">

            <Border Background="#F0202020"
                    BorderBrush="#40FFFFFF"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="15"
                    Width="200">

                <StackPanel>
                    <TextBlock Text="Schriftgröße:" Foreground="White" Margin="0,0,0,5"/>

                    <ComboBox Name="FontSizeComboBox" Margin="0,0,0,10" SelectionChanged="FontSizeComboBox_SelectionChanged">
                        <ComboBoxItem Content="12"/>
                        <ComboBoxItem Content="14"/>
                        <ComboBoxItem Content="16"/>
                        <ComboBoxItem Content="18"/>
                    </ComboBox>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>